# ---------- Database (docker-compose) ----------
POSTGRES_USER=eplant
POSTGRES_PASSWORD=eplant
POSTGRES_DB=eplant
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Used by Prisma / the API
DATABASE_URL="postgresql://eplant:eplant@localhost:5432/eplant?schema=public"

# ---------- API ----------
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ---------- Web ----------
# Server-side base URL the Next.js app uses to reach the API
API_BASE_URL=http://localhost:3001
# Browser-side base URL (leave empty to use the built-in /api proxy)
NEXT_PUBLIC_API_BASE_URL=

# ---------- Auth (Step 3) ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Images (Step 4) ----------
# Leave empty to store uploads on local disk under uploads/ (dev fallback).
# From your Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ---------- Added in later steps ----------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# PLANT_ID_API_KEY=
# OPENAI_API_KEY=
